   "source": [
    "# 9. Write a lambda that checks if a string has more than 5 characters, use filter() to keep only long words\n",
    "strings = [\"cat\", \"elephant\", \"dog\", \"python\", \"ai\"]\n",
    "\n",
    "# 'lambda text: len(text) > 5' counts the characters in each string.\n",
    "# It returns True when the string has more than 5 characters.\n",
    "# filter() keeps only the strings where the answer is True.\n",
    "long_strings = list(filter(lambda text: len(text) > 5, strings))\n",
    "\n",
    "# print() shows only the long strings.\n",
    "print(long_strings)"
   ]
