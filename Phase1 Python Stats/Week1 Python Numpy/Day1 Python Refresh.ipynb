    "# 7. Write a lambda that cubes a number (x**3), apply it with map() to the list below\n",
    "numbers = [1, 2, 3, 4]\n",
    "\n",
    "# 'lambda number: number ** 3' is a small function.\n",
    "# It takes one number and raises it to the third power.\n",
    "# map() applies that function to every number in the list.\n",
    "# list() changes the map result into a normal list.\n",
    "cubed_numbers = list(map(lambda number: number ** 3, numbers))\n",
    "\n",
    "# print() shows the cubed numbers.\n",
    "print(cubed_numbers)"
   ]
