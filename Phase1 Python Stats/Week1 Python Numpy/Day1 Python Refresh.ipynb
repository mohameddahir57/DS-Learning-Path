   ],
   "source": [
    "# 1. Build a list containing the square of every number from 1 to 10\n",
    "\n",
    "# 'range(1, 11)' gives us the numbers 1 through 10.\n",
    "# The number 11 is not included.\n",
    "# 'x' means one number at a time from that range.\n",
    "# '** 2' means square the number (multiply it by itself).\n",
    "# The brackets [ ] create a new list.\n",
    "squares = [x ** 2 for x in range(1, 11)]\n",
    "\n",
    "# print() shows the answer on the screen.\n",
    "print(squares)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
