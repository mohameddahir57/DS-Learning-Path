   "source": [
    "# 8. Write a lambda that returns True for positive numbers, use filter() to remove the negatives\n",
    "numbers2 = [-5, 3, -2, 8, -1, 10]\n",
    "\n",
    "# 'lambda number: number > 0' checks whether a number is positive.\n",
