   "source": [
    "# 4. Convert each Celsius value below to Fahrenheit: (C * 9/5) + 32\n",
    "celsius = [0, 10, 20, 30]\n",
    "\n",
    "# 'c' means one Celsius value at a time.\n",
    "# We use the formula: (C * 9/5) + 32.\n",
    "fahrenheit = [(c * 9 / 5) + 32 for c in celsius]\n",
    "\n",
    "# print() shows the converted Fahrenheit values.\n",
    "print(fahrenheit)"
   ]
  },
  {
   "cell_type": "code",
