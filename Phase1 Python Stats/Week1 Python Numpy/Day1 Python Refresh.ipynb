   "source": [
    "# 5. Keep only the words that START with a vowel (a, e, i, o, u)\n",
    "words2 = [\"apple\", \"banana\", \"orange\", \"grape\", \"egg\"]\n",
    "\n",
    "# 'word[0]' gets the first letter of each word.\n",
