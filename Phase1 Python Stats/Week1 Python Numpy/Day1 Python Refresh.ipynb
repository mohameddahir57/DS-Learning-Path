   "source": [
    "# 6. Build a list of tuples (number, is_even) for numbers 1 to 10\n",
    "#    e.g. the first pair should be (1, False) since 1 is odd\n",
    "\n",
    "# 'number % 2 == 0' checks whether each number is even.\n",
    "# Each pair contains the number and either True or False.\n",
